// Start on ordinary solid ground in a single-player survival world.
// Uses nearby logs and mixes vanilla plank types when crafting.
function count_item(id) {
    int total = 0;
    for (slot in player.inventory.slots) {
        if (slot != none && slot.id == id) { total = total + slot.count; }
    }
    return total;
}

function center(value) {
    return value - (value % 1 + 1) % 1 + 0.5;
}

function craft_item(id) {
    int before = count_item(id);
    for (int attempt = 0; attempt < 12; attempt++) {
        Record recipe = player.find_recipe(id);
        if (recipe != none) {
            player.craft(recipe.display_id);
            for (int tick = 0; tick < 16; tick++) {
                if (count_item(id) > before) { return true; }
                sleep(150ms);
            }
            print("合成后未在背包确认产物：", id);
            return false;
        }
        sleep(200ms);
    }
    print("没有已解锁且材料足够的配方：", id);
    return false;
}

function approach(x, y, z) {
    Record origin = player.snapshot();
    int preferred_x = -1;
    int preferred_z = -1;
    if (origin.x > x) { preferred_x = 1; }
    if (origin.z > z) { preferred_z = 1; }
    for (int side = 0; side < 4; side++) {
        int dx = 0;
        int dz = 0;
        if (side == 0) { dx = preferred_x; }
        if (side == 1) { dz = preferred_z; }
        if (side == 2) { dx = -preferred_x; }
        if (side == 3) { dz = -preferred_z; }
        for (int height = 0; height < 4; height++) {
            int dy = 0;
            if (height == 1) { dy = -1; }
            if (height == 2) { dy = 1; }
            if (height == 3) { dy = -2; }
            Vec3 feet = vec3(x + dx, y + dy, z + dz);
            if (world.can_stand(feet)) {
                print("尝试落脚点：", feet);
                if (player.try_walk_to(feet, timeout=8s) == "arrived") { return true; }
                print("这条路线走不通，尝试另一侧");
            }
        }
    }
    return false;
}

function wood_family(index) {
    if (index == 0) { return "oak"; }
    if (index == 1) { return "spruce"; }
    if (index == 2) { return "birch"; }
    if (index == 3) { return "jungle"; }
    if (index == 4) { return "acacia"; }
    if (index == 5) { return "dark_oak"; }
    if (index == 6) { return "mangrove"; }
    if (index == 7) { return "cherry"; }
    if (index == 8) { return "pale_oak"; }
    if (index == 9) { return "crimson"; }
    return "warped";
}

function log_type(index) {
    string wood = "minecraft:" + wood_family(index);
    if (index >= 9) { return wood + "_stem"; }
    return wood + "_log";
}

function count_planks() {
    int total = 0;
    for (slot in player.inventory.slots) {
        if (slot != none) {
            for (int index = 0; index < 11; index++) {
                if (slot.id == "minecraft:" + wood_family(index) + "_planks") { total = total + slot.count; }
            }
            if (slot.id == "minecraft:bamboo_planks") { total = total + slot.count; }
        }
    }
    return total;
}

function make_planks(index, required) {
    string log_id = log_type(index);
    string planks = "minecraft:" + wood_family(index) + "_planks";
    while (count_item(log_id) > 0 && count_planks() < required) {
        if (!craft_item(planks)) { return false; }
    }
    return count_planks() >= required;
}

function gather_wood(required) {
    if (count_planks() >= required) { return true; }
    for (int index = 0; index < 11; index++) {
        if (count_item(log_type(index)) > 0 && make_planks(index, required)) { return true; }
    }
    for (int index = 0; index < 11; index++) {
        string log_id = log_type(index);
        Record tree = world.nearest_block(log_id, radius=12);
        if (tree != none) {
            gather_trunk(tree.position, log_id, required - count_planks());
            if (make_planks(index, required)) { return true; }
            Record alternate = world.nearest_block(log_id, radius=12, exclude_column=tree.position);
            if (alternate != none) {
                print("木板仍不足，尝试另一处树干：", log_id);
                gather_trunk(alternate.position, log_id, required - count_planks());
                if (make_planks(index, required)) { return true; }
            }
        }
    }
    print("附近的可达树干已尝试。背包木板：", count_planks(), "；需要：", required);
    return false;
}

function gather_trunk(position, log_id, planks_needed) {
    float x = center(position.x);
    float z = center(position.z);
    float bottom = position.y - 0.5;
    Record below = world.block(vec3(x, bottom - 1, z));
    for (int depth = 0; depth < 5 && below.id == log_id; depth++) {
        bottom--;
        below = world.block(vec3(x, bottom - 1, z));
    }
    if (!approach(x, bottom, z)) { print("树干四周没有可达落脚点：", vec3(x, bottom, z)); return false; }
    Record stance = player.snapshot();
    string face = "north";
    float dx = stance.x - x;
    float dz = stance.z - z;
    if (dx * dx > dz * dz) {
        if (dx > 0) { face = "east"; }
        else { face = "west"; }
    } else if (dz > 0) { face = "south"; }
    int before = count_item(log_id);
    int mined = 0;
    print("已到树旁，开始采集：", log_id, vec3(x, bottom, z));
    // Include one spare log in case a drop rolls off the ground.
    for (int height = 0; height < 4 && mined * 4 < planks_needed + 4; height++) {
        Vec3 trunk = vec3(x, bottom + height, z);
        Record block = world.block(trunk);
        if (block.id == log_id && (count_item(log_id) - before) * 4 < planks_needed) {
            player.look_at_block(trunk, face=face);
            Record hit = world.target_block();
            if (hit == none || hit.position.x != x - 0.5 || hit.position.y != bottom + height || hit.position.z != z - 0.5) {
                print("跳过视线受阻的原木：", trunk);
            } else {
                player.mine(block, face=hit.face, timeout=20s);
                mined++;
            }
        }
    }
    if (mined == 0) { return false; }
    // Only use the trunk's original ground level. Never follow item entities down a drop.
    Vec3 pile = vec3(x, bottom, z);
    if ((count_item(log_id) - before) * 4 < planks_needed && world.can_stand(pile)) {
        player.try_walk_to(pile, timeout=6s);
    }
    for (int tick = 0; tick < 10 && (count_item(log_id) - before) * 4 < planks_needed; tick++) {
        sleep(200ms);
    }
    int collected = count_item(log_id) - before;
    print("砍下：", mined, "；实际捡到：", collected, log_id);
    if (collected < mined && collected * 4 < planks_needed) {
        print("部分掉落物未拾取，继续寻找其他原木");
    }
    return collected > 0;
}

function select_table() {
    int table_slot = -1;
    int empty = -1;
    int index = 0;
    for (slot in player.inventory.slots) {
        if (slot == none && index < 9 && empty < 0) { empty = index; }
        if (slot != none && slot.slot < 36 && slot.id == "minecraft:crafting_table" && table_slot < 0) { table_slot = slot.slot; }
        index++;
    }
    if (table_slot < 0) { return false; }
    if (table_slot >= 9) {
        if (empty < 0) { print("请留一个空快捷栏格"); return false; }
        player.move_item(table_slot, empty);
        sleep(250ms);
        table_slot = empty;
    }
    player.select_hotbar(table_slot);
    Record selected = player.snapshot();
    return selected.item == "minecraft:crafting_table";
}

function place_table() {
    Record feet = player.snapshot();
    for (int side = 0; side < 4; side++) {
        int dx = 0;
        int dz = 0;
        if (side == 0) { dx = 2; }
        if (side == 1) { dx = -2; }
        if (side == 2) { dz = 2; }
        if (side == 3) { dz = -2; }
        float x = center(feet.x) + dx;
        float z = center(feet.z) + dz;
        Vec3 spot = vec3(x, feet.y, z);
        Record air = world.block(spot);
        Record support = world.block(vec3(x, feet.y - 1, z));
        if (air.air && support.solid && world.can_stand(spot)) {
            player.look_at_block(support.position, face="up");
            Record hit = world.target_block();
            if (hit != none && hit.face == "up" && hit.position.x == support.position.x
                && hit.position.y == support.position.y && hit.position.z == support.position.z) {
                print("放置工作台：", spot);
                return player.place_block(support, face="up");
            }
        }
    }
    print("附近没有合适的工作台摆放位置");
    return none;
}

function run_pickaxe() {
    if (count_item("minecraft:wooden_pickaxe") > 0) { return true; }
    Record menu = player.container;
    if (menu.type == "CraftingMenu" && player.find_recipe("minecraft:wooden_pickaxe") != none) {
        print("继续使用已打开的工作台");
        return craft_item("minecraft:wooden_pickaxe");
    }
    int required = 3;
    if (count_item("minecraft:crafting_table") == 0) { required = required + 4; }
    if (count_item("minecraft:stick") < 2) { required = required + 2; }
    if (!gather_wood(required)) { return false; }
    print("木板已备齐，准备制作工作台和木棍");
    if (count_item("minecraft:crafting_table") == 0 && !craft_item("minecraft:crafting_table")) { return false; }
    if (count_item("minecraft:stick") < 2 && !craft_item("minecraft:stick")) { return false; }
    if (!select_table()) { print("无法选中工作台"); return false; }
    Record table = place_table();
    if (table == none) { return false; }
    player.open_crafting_table(table.position);
    print("已尝试打开工作台，开始制作木镐");
    sleep(450ms);
    return craft_item("minecraft:wooden_pickaxe");
}

print("木镐任务开始：检查背包及附近树木");
if (run_pickaxe()) {
    print("完成：已确认背包里有木镐");
    say("已确认背包里有木镐");
}
else {
    print("任务未完成；请查看以上最后一条进度或失败原因");
    say("任务未完成，具体原因见脚本输出");
}
